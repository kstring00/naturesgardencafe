# Public URL of the deployed site. Drives canonical, Open Graph and JSON-LD URLs.
NEXT_PUBLIC_SITE_URL=https://naturesgardencafe.vercel.app

# "demo" keeps the site out of search results (noindex). Set to "live" at launch.
NEXT_PUBLIC_SITE_MODE=demo

# When set, Order delivery / Order pickup link straight to this page
# (Toast, Square, DoorDash…) and the call-to-order panel is skipped.
# NEXT_PUBLIC_ORDER_URL=https://order.example.com/natures-garden
